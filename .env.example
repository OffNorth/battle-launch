# ─────────────────────────────────────────────────────────────────────────────
# BATTLE LAUNCH : modèle des variables d'environnement (AUCUNE valeur réelle ici).
# En local : copier les lignes utiles dans apps/web/.env.local et apps/worker/.env
# (ignorés par Git). En ligne : les valeurs se saisissent dans Vercel (site) et
# Railway (worker), jamais dans le code, jamais dans un message.
# Les variables NEXT_PUBLIC_* sont visibles par le navigateur : jamais de secret dedans.
# Chaque application valide ses variables au démarrage et nomme celle qui manque
# (jamais sa valeur).
# ─────────────────────────────────────────────────────────────────────────────

# ═════════════════════════ SITE (apps/web, Vercel) ═══════════════════════════

# Adresse du projet Supabase et clé « publishable » (publiques, soumises à la RLS).
# Pas de clé « secret » (service_role) : le site écrit avec la session de l'utilisateur,
# par des fonctions SQL qui le vérifient elles-mêmes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Réseau Solana vu par le navigateur : devnet (par défaut) ou mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC public (sans clé) utilisé par le navigateur pour envoyer les transactions signées.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Adresse publique du site (liens de partage, images OG, métadonnées des tokens).
# Doit être identique à APP_URL du worker.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Facultatif : mode Auto-IA (deux concepts opposés générés par Claude). SECRET.
# Vide : le mode Auto-IA répond « indisponible », le reste du site marche.
ANTHROPIC_API_KEY=

# ════════════════════════ WORKER (apps/worker, Railway) ══════════════════════

# Adresse du Redis (fournie par le service Redis Railway, contient un mot de passe). SECRET.
REDIS_URL=

# Base de données.
# - En LOCAL : DATABASE_URL = connexion du compte `battle_worker` (contient son mot de passe). SECRET.
# - En PRODUCTION : laisser DATABASE_URL vide. Le worker se connecte en `battle_worker_prod` avec
#   un mot de passe qu'il tire lui-même au premier démarrage et garde dans son Redis. Pour ce
#   premier démarrage seulement, BOOTSTRAP_DATABASE_URL donne un identifiant d'amorçage à usage
#   unique (compte `battle_bootstrap`, qui se désactive tout seul). SECRET.
DATABASE_URL=
BOOTSTRAP_DATABASE_URL=
# Où se connecter en production (pooler Supabase, mode session). Valeurs par défaut correctes
# pour le projet battle-launch ; rien de secret.
# DB_HOST=aws-1-eu-west-3.pooler.supabase.com
# DB_PORT=5432
# DB_USER=battle_worker_prod.<id du projet>
# DB_NAME=postgres

# Réseau Solana du worker. mainnet-beta est refusé sans ALLOW_MAINNET=yes, à ne poser
# qu'après validation explicite (le lancement mainnet demande aussi un bundle Jito, pas encore fait).
SOLANA_CLUSTER=devnet
# ALLOW_MAINNET=
# RPC côté serveur (lecture des trades, envoi des lancements). Helius conseillé :
# https://devnet.helius-rpc.com/?api-key=...  Une adresse avec clé est un SECRET.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Adresse publique du site (identique à NEXT_PUBLIC_APP_URL).
APP_URL=http://localhost:3000

# Port du serveur de santé GET /health (Railway le fournit tout seul).
PORT=8080

# Facultatif : annonce des gagnants sur Telegram (les deux, ou aucun). Le token est un SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
