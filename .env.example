# ─────────────────────────────────────────────────────────────────────────────
# BATTLE LAUNCH : modèle des variables d'environnement (AUCUNE valeur réelle ici).
# En local : copier en .env (ignoré par Git) dans apps/web/ et apps/worker/.
# En ligne : les valeurs se saisissent dans Vercel (site) et Railway (worker),
# jamais dans le code, jamais dans un message.
# Les variables NEXT_PUBLIC_* sont visibles par le navigateur : jamais de secret dedans.
# ─────────────────────────────────────────────────────────────────────────────

# ── Réseau Solana ────────────────────────────────────────────────────────────
# devnet (par défaut) ou mainnet-beta. mainnet-beta est refusé sans ALLOW_MAINNET=yes,
# à ne poser qu'après validation explicite.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# ALLOW_MAINNET=

# RPC côté serveur (worker, API du site). Helius conseillé : https://devnet.helius-rpc.com/?api-key=...
# L'adresse contient une clé : SECRET.
SOLANA_RPC_URL=
# RPC utilisé par le navigateur pour envoyer les transactions signées. Public (sans clé) :
# https://api.devnet.solana.com en devnet.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Clé API Helius (lecture des transactions et des holders). SECRET.
HELIUS_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Adresse du projet (publique).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
# Clé « publishable » (publique, soumise à la RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Pas de clé « secret » (service_role) : le site écrit avec la session de l'utilisateur, par des
# fonctions SQL qui le vérifient elles-mêmes. Le worker a son propre compte base de données.

# ── Worker (Railway) ─────────────────────────────────────────────────────────
# Adresse du Redis (fournie par le service Redis Railway, contient un mot de passe). SECRET.
REDIS_URL=
# Port du serveur de santé (Railway le fournit tout seul).
PORT=8080

# ── Facultatif ───────────────────────────────────────────────────────────────
# Mode Auto-IA (génération de deux concepts opposés). SECRET.
ANTHROPIC_API_KEY=
# Annonces du gagnant sur Telegram. SECRET.
TELEGRAM_BOT_TOKEN=
