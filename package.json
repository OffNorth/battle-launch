{
  "name": "battle-launch",
  "private": true,
  "description": "BATTLE LAUNCH : deux memecoins pump.fun lancés en même temps qui s'affrontent en direct",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "^5.9.3"
  }
}
