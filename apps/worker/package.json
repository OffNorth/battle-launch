{
  "name": "@battle/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker BullMQ : minuteries du lobby, lancement, lecture des trades, stats, clôture",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "once": "tsx --env-file-if-exists=.env src/once.ts"
  },
  "dependencies": {
    "@battle/shared": "*",
    "@pump-fun/pump-sdk": "^4.2.0",
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.118.0",
    "bn.js": "^5.2.5",
    "bullmq": "^6.3.19",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
